        <mxCell id="oA" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="ATmega" vertex="1">
          <mxGeometry height="700" width="100" x="350" y="720" as="geometry" />
        </mxCell>
        <mxCell id="oR" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="DS3231 RTC" vertex="1">
          <mxGeometry height="700" width="100" x="600" y="720" as="geometry" />
        </mxCell>
        <mxCell id="oS" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;" value="ESP32-CAM" vertex="1">
          <mxGeometry height="700" width="100" x="850" y="720" as="geometry" />
        </mxCell>
        <mxCell id="o1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;" value="read time (about once per second)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="800" as="sourcePoint" />
            <mxPoint x="650" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="o2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" value="time &gt;= window end">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="840" as="sourcePoint" />
            <mxPoint x="400" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="o3" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" value="Peak window over. Leave the peak loop; no new cycle is started." vertex="1">
          <mxGeometry height="50" width="260" x="430" y="860" as="geometry" />
        </mxCell>
        <mxCell id="oalt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;align=left;verticalAlign=top;fontStyle=2;" value="if a cycle is in progress" vertex="1">
          <mxGeometry height="60" width="590" x="370" y="935" as="geometry" />
        </mxCell>
        <mxCell id="o4" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;" value="ESP_CMD_ABORT">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="975" as="sourcePoint" />
            <mxPoint x="900" y="975" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="o5" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" value="ESP32 deep-sleeps" vertex="1">
          <mxGeometry height="40" width="150" x="960" y="945" as="geometry" />
        </mxCell>
        <mxCell id="o6" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;" value="PEAK_END">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="1040" as="sourcePoint" />
            <mxPoint x="150" y="1040" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="o7" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" value="ACK(PEAK_END, OK)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="1080" as="sourcePoint" />
            <mxPoint x="400" y="1080" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="o8" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" value="ETLC: back to NORMAL. Fixed timing only. Stops sending RED_STARTED, ignores everything except PEAK_START and PING." vertex="1">
          <mxGeometry height="90" width="250" x="10" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="o9" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="No ACK within 150 ms: resend the same frame, up to 3 retries. Then log FAULT_PEAKEND_NO_ACK and carry on. If it is lost completely, the ETLC returns to NORMAL after its silence timeout (about 20 min)." vertex="1">
          <mxGeometry height="100" width="330" x="430" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="o10" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="ATmega enters power-down sleep. The next alarm was already armed at peak start. ESP32 is already in deep sleep." vertex="1">
          <mxGeometry height="70" width="330" x="430" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="o11" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" value="RTC alarm (A3): next window start">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="1340" as="sourcePoint" />
            <mxPoint x="400" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="o12" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" value="ATmega wakes, arms the next alarm again, starts a new peak sequence (flow page 5)." vertex="1">
          <mxGeometry height="50" width="330" x="430" y="1360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="10 Protocol reference">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" value="TLCP reference: frame, commands, message sequence and ETLC behaviour (RS-485, 9600 8N1)" style="text;html=1;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="SOF&lt;br&gt;0xA5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="SEQ&lt;br&gt;1 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="130" y="40" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="CMD&lt;br&gt;1 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="LEN&lt;br&gt;0..4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="310" y="40" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="PAYLOAD&lt;br&gt;LEN bytes, big endian" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="CRC-8&lt;br&gt;poly 0x07, init 0&lt;br&gt;over SEQ..PAYLOAD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cm" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;th&gt;Code&lt;/th&gt;&lt;th&gt;Command&lt;/th&gt;&lt;th&gt;From&lt;/th&gt;&lt;th&gt;Payload&lt;/th&gt;&lt;th&gt;Meaning&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x01&lt;/td&gt;&lt;td&gt;PEAK_START&lt;/td&gt;&lt;td&gt;ATmega&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;peak window began&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x02&lt;/td&gt;&lt;td&gt;RED_STARTED&lt;/td&gt;&lt;td&gt;ETLC&lt;/td&gt;&lt;td&gt;u16 secsToGreen&lt;/td&gt;&lt;td&gt;camera road red now&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x03&lt;/td&gt;&lt;td&gt;GREEN_TIME&lt;/td&gt;&lt;td&gt;ATmega&lt;/td&gt;&lt;td&gt;u16 greenSecs, u8 level&lt;/td&gt;&lt;td&gt;proposed next green&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x04&lt;/td&gt;&lt;td&gt;PEAK_END&lt;/td&gt;&lt;td&gt;ATmega&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;resume fixed timing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x05&lt;/td&gt;&lt;td&gt;PING&lt;/td&gt;&lt;td&gt;either&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;link check&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x80&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;td&gt;either&lt;/td&gt;&lt;td&gt;u8 cmd, u8 status&lt;/td&gt;&lt;td&gt;accepted&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x81&lt;/td&gt;&lt;td&gt;NAK&lt;/td&gt;&lt;td&gt;either&lt;/td&gt;&lt;td&gt;u8 cmd, u8 reason&lt;/td&gt;&lt;td&gt;refused&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="720" height="190" as="geometry" />
        </mxCell>
        <mxCell id="st" value="&lt;b&gt;Status / reason codes&lt;/b&gt;&lt;br&gt;0 OK, 1 BAD_STATE, 2 OUT_OF_RANGE, 3 LATE, 4 BUSY, 5 UNKNOWN_CMD, 6 BAD_LEN&lt;br&gt;&lt;br&gt;&lt;b&gt;Timing&lt;/b&gt;&lt;br&gt;inter-byte timeout 20 ms; reply delay 3 ms&lt;br&gt;ACK timeout 150 ms, 3 retries (4 tries total)&lt;br&gt;ETLC retries at 200 ms (breaks collision tie)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="40" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lA" value="ATmega" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="360" width="100" height="440" as="geometry" />
        </mxCell>
        <mxCell id="lE" value="ETLC" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="100" height="440" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="PEAK_START" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="430" as="sourcePoint" />
            <mxPoint x="610" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q2" value="ACK(PEAK_START, OK)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="470" as="sourcePoint" />
            <mxPoint x="250" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q3" value="RED_STARTED (secsToGreen)  [road turned red]" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="530" as="sourcePoint" />
            <mxPoint x="250" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q4" value="ACK(RED_STARTED, OK)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="570" as="sourcePoint" />
            <mxPoint x="610" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q5" value="... accumulate, wake ESP32, capture ..." style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="270" y="585" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="q6" value="GREEN_TIME (greenSecs, level)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="660" as="sourcePoint" />
            <mxPoint x="610" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q7" value="ACK(OK)  or  NAK(LATE / OUT_OF_RANGE / BAD_STATE)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="700" as="sourcePoint" />
            <mxPoint x="250" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="q8" value="PEAK_END  -&gt;  ACK  (at window end)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="760" as="sourcePoint" />
            <mxPoint x="610" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="es" value="&lt;b&gt;ETLC side rules&lt;/b&gt;&lt;br&gt;NORMAL: fixed timing, accepts PEAK_START and PING only&lt;br&gt;ADAPTIVE_IDLE: fixed timing; sends RED_STARTED when the camera road turns red&lt;br&gt;AWAIT_GREEN_TIME: accepts GREEN_TIME until (secsToGreen - guard)&lt;br&gt;GREEN_TIME is applied ONCE, to the next green only&lt;br&gt;Checks: right state, enough time left, greenSecs within its own min/max&lt;br&gt;PEAK_END or ATmega silence timeout: back to NORMAL&lt;br&gt;Never violates its own safety timings" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="440" height="200" as="geometry" />
        </mxCell>
        <mxCell id="el" value="&lt;b&gt;Line discipline&lt;/b&gt;&lt;br&gt;Only one node transmits at a time; the sender waits for the reply.&lt;br&gt;TX: DE=1, /RE=1. RX: DE=0, /RE=0. Switch back after TXC.&lt;br&gt;The one possible clash (PEAK_END vs RED_STARTED) is resolved by retries with different delays." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="590" width="440" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="proto" name="11 ETLC state machine and frame">
    <mxGraphModel dx="1447" dy="816" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" parent="1" style="text;html=1;fontStyle=1;fontSize=16;" value="TLCP v1: ATmega - ETLC custom protocol (RS-485, 9600 8N1, half-duplex)" vertex="1">
          <mxGeometry height="30" width="800" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="fr" parent="1" style="text;html=1;fontSize=13;" value="&lt;b&gt;Frame&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="100" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" value="SOF&lt;br&gt;0xA5&lt;br&gt;1 B" vertex="1">
          <mxGeometry height="60" width="90" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" value="SEQ&lt;br&gt;1 B" vertex="1">
          <mxGeometry height="60" width="90" x="130" y="80" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" value="CMD&lt;br&gt;1 B" vertex="1">
          <mxGeometry height="60" width="90" x="220" y="80" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;" value="LEN&lt;br&gt;0..4" vertex="1">
          <mxGeometry height="60" width="90" x="310" y="80" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" value="PAYLOAD&lt;br&gt;LEN bytes, big endian" vertex="1">
          <mxGeometry height="60" width="200" x="400" y="80" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;" value="CRC8&lt;br&gt;poly 0x07, init 0&lt;br&gt;over SEQ..PAYLOAD" vertex="1">
          <mxGeometry height="60" width="150" x="600" y="80" as="geometry" />
        </mxCell>
        <mxCell id="cm" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;th&gt;Code&lt;/th&gt;&lt;th&gt;Command&lt;/th&gt;&lt;th&gt;From&lt;/th&gt;&lt;th&gt;Payload&lt;/th&gt;&lt;th&gt;Meaning&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x01&lt;/td&gt;&lt;td&gt;PEAK_START&lt;/td&gt;&lt;td&gt;ATmega&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;peak window began&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x02&lt;/td&gt;&lt;td&gt;RED_STARTED&lt;/td&gt;&lt;td&gt;ETLC&lt;/td&gt;&lt;td&gt;u16 secsToGreen&lt;/td&gt;&lt;td&gt;camera road is red now&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x03&lt;/td&gt;&lt;td&gt;GREEN_TIME&lt;/td&gt;&lt;td&gt;ATmega&lt;/td&gt;&lt;td&gt;u16 greenSecs, u8 level&lt;/td&gt;&lt;td&gt;proposed next green&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x04&lt;/td&gt;&lt;td&gt;PEAK_END&lt;/td&gt;&lt;td&gt;ATmega&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;back to fixed timing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x05&lt;/td&gt;&lt;td&gt;PING&lt;/td&gt;&lt;td&gt;either&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;link check&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x80&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;td&gt;either&lt;/td&gt;&lt;td&gt;u8 cmd, u8 status&lt;/td&gt;&lt;td&gt;accepted&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x81&lt;/td&gt;&lt;td&gt;NAK&lt;/td&gt;&lt;td&gt;either&lt;/td&gt;&lt;td&gt;u8 cmd, u8 reason&lt;/td&gt;&lt;td&gt;refused&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="700" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="st" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Status / reason codes&lt;/b&gt;&lt;br&gt;0 OK, 1 BAD_STATE, 2 OUT_OF_RANGE, 3 LATE, 4 BUSY, 5 UNKNOWN_CMD, 6 BAD_LEN&lt;br&gt;&lt;br&gt;&lt;b&gt;Timing&lt;/b&gt;&lt;br&gt;inter-byte timeout 20 ms&lt;br&gt;reply delay 3 ms&lt;br&gt;ACK timeout 150 ms (ETLC retries at 200 ms)&lt;br&gt;3 retries, then fail&lt;br&gt;&lt;br&gt;&lt;b&gt;Link rules&lt;/b&gt;&lt;br&gt;- every command is answered by ACK or NAK&lt;br&gt;- retry reuses the SEQ; duplicates are re-ACKed, not re-run&lt;br&gt;- bad CRC: drop silently&lt;br&gt;- TX: DE=1, /RE=1; RX: DE=0, /RE=0; switch after TXC" vertex="1">
          <mxGeometry height="310" width="340" x="780" y="50" as="geometry" />
        </mxCell>
        <mxCell id="es" parent="1" style="text;html=1;fontSize=13;" value="&lt;b&gt;ETLC state machine (to implement on the ETLC)&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="400" x="40" y="400" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="NORMAL&lt;br&gt;fixed timing" vertex="1">
          <mxGeometry height="80" width="160" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="ADAPTIVE_IDLE&lt;br&gt;fixed timing,&lt;br&gt;sends RED_STARTED" vertex="1">
          <mxGeometry height="80" width="180" x="340" y="480" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="AWAIT_GREEN_TIME&lt;br&gt;accepts GREEN_TIME" vertex="1">
          <mxGeometry height="80" width="190" x="660" y="480" as="geometry" />
        </mxCell>
        <mxCell id="x1" edge="1" parent="1" source="e1" style="endArrow=classic;html=1;" target="e2" value="PEAK_START">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x2" edge="1" parent="1" source="e2" style="endArrow=classic;html=1;" target="e3" value="RED_STARTED ACKed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x3" edge="1" parent="1" source="e3" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="e2" value="GREEN_TIME applied or deadline passed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="755" y="610" />
              <mxPoint x="430" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="x4" edge="1" parent="1" source="e2" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="e1" value="PEAK_END or silence timeout (from either state)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="450" />
              <mxPoint x="120" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ev" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;ETLC validation of GREEN_TIME&lt;/b&gt;&lt;br&gt;- state must be AWAIT_GREEN_TIME, else NAK BAD_STATE&lt;br&gt;- time left to green &gt;= guard, else NAK LATE&lt;br&gt;- greenSecs inside [min, max], else NAK OUT_OF_RANGE&lt;br&gt;- apply once, to the next green only&lt;br&gt;- never break own safety timings" vertex="1">
          <mxGeometry height="110" width="430" x="40" y="650" as="geometry" />
        </mxCell>
        <mxCell id="av" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;ATmega send conditions&lt;/b&gt;&lt;br&gt;- PEAK_START: at peak start, retry via PEAK_FALLBACK + PING&lt;br&gt;- GREEN_TIME: only if it arrives at least GUARD_S before green&lt;br&gt;- PEAK_END: when RTC time passes window end; abort ESP32 first&lt;br&gt;- Budget: A + T_esp + T_tx + G &lt;= secsToGreen" vertex="1">
          <mxGeometry height="110" width="430" x="500" y="650" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="regatm" name="12 ATmega register file">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" value="ATmega register files (EEPROM parameters, RAM status)" style="text;html=1;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p" value="&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#dae8fc&quot;&gt;&lt;th&gt;Addr&lt;/th&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Default&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x00&lt;/td&gt;&lt;td&gt;MAGIC&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;0x544C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x02&lt;/td&gt;&lt;td&gt;VERSION&lt;/td&gt;&lt;td&gt;u8&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x03&lt;/td&gt;&lt;td&gt;ACCUM_DELAY_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x05&lt;/td&gt;&lt;td&gt;ACCUM_MIN_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;15&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x07&lt;/td&gt;&lt;td&gt;GUARD_S&lt;/td&gt;&lt;td&gt;u8&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x08&lt;/td&gt;&lt;td&gt;ESP_TIMEOUT_S&lt;/td&gt;&lt;td&gt;u8&lt;/td&gt;&lt;td&gt;15&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x09&lt;/td&gt;&lt;td&gt;ESP_POLL_MS&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;250&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0B&lt;/td&gt;&lt;td&gt;GREEN_MIN_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;10 (placeholder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0D&lt;/td&gt;&lt;td&gt;GREEN_MAX_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;60 (placeholder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0F&lt;/td&gt;&lt;td&gt;GREEN_L0_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;10 (placeholder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x11&lt;/td&gt;&lt;td&gt;GREEN_L1_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;20 (placeholder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x13&lt;/td&gt;&lt;td&gt;GREEN_L2_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;35 (placeholder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x15&lt;/td&gt;&lt;td&gt;GREEN_L3_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;50 (placeholder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x17&lt;/td&gt;&lt;td&gt;PING_RETRY_S&lt;/td&gt;&lt;td&gt;u16&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x19&lt;/td&gt;&lt;td&gt;PEAK_START_RETRIES&lt;/td&gt;&lt;td&gt;u8&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x1A&lt;/td&gt;&lt;td&gt;SCHED_COUNT&lt;/td&gt;&lt;td&gt;u8&lt;/td&gt;&lt;td&gt;2 (max 4)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x1B&lt;/td&gt;&lt;td&gt;SCHED[0..3]&lt;/td&gt;&lt;td&gt;4 x 6 B&lt;/td&gt;&lt;td&gt;see right&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x33&lt;/td&gt;&lt;td&gt;CRC&lt;/td&gt;&lt;td&gt;u8&lt;/td&gt;&lt;td&gt;over 0x00..0x32&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="480" height="470" as="geometry" />
        </mxCell>
        <mxCell id="sc" value="&lt;b&gt;Schedule entry (6 bytes)&lt;/b&gt;&lt;br&gt;[0] dowMask: bit0 Sun ... bit6 Sat&lt;br&gt;[1] startHour&lt;br&gt;[2] startMin&lt;br&gt;[3] endHour&lt;br&gt;[4] endMin&lt;br&gt;[5] flags: bit0 enabled&lt;br&gt;&lt;br&gt;Windows: no midnight crossing, no overlap&lt;br&gt;Default (placeholder): Mon-Fri 07:30-09:30 and 16:30-18:30&lt;br&gt;If EEPROM magic/CRC bad: use defaults" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rs" value="&lt;b&gt;Runtime status (RAM)&lt;/b&gt;&lt;br&gt;state (u8)&lt;br&gt;rtcValid, peakActive, linkUp (bool)&lt;br&gt;cycleCount, sentCount, fallbackCount (u16)&lt;br&gt;lastLevel, lastMeanGrad, lastCaptureId (u8)&lt;br&gt;lastGreenS (u16)&lt;br&gt;lastError (FaultCode)&lt;br&gt;txSeq (u8)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ft" value="&lt;b&gt;Fault codes (lastError)&lt;/b&gt;&lt;br&gt;01 RTC_OSF, 02 RTC_COMM, 03 ETLC_NO_ACK, 04 NO_RED, 05 RED_TOO_SHORT, 06 WAKE_LINE_STUCK, 07 ESP_TIMEOUT, 08 ESP_ERROR, 09 ESP_BAD_DATA, 0A DEADLINE, 0B GREEN_REFUSED, 0C PEAKEND_NO_ACK" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rt" value="&lt;b&gt;DS3231 registers used&lt;/b&gt;&lt;br&gt;0x00-0x06 time/date   0x07-0x0A Alarm 1&lt;br&gt;0x0E Control: INTCN=1, A1IE=1&lt;br&gt;0x0F Status: OSF bit7 (check at boot), A1F bit0 (clear after alarm)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="480" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="13 ESP32 register file and flow">
    <mxGraphModel dx="1741" dy="981" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" parent="1" style="text;html=1;fontStyle=1;fontSize=16;" value="ESP32-CAM register file (what the ATmega sees over I2C, slave 0x08) and the flow that fills it" vertex="1">
          <mxGeometry height="24" width="1000" x="40" as="geometry" />
        </mxCell>
        <mxCell id="rf" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Result register: ATmega reads 6 bytes in one transfer&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr style=&quot;background:#e1d5e7&quot;&gt;&lt;th&gt;Byte&lt;/th&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Values&lt;/th&gt;&lt;th&gt;Written when&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td&gt;0 NOT_READY, 1 READY, 2 ERROR&lt;/td&gt;&lt;td&gt;NOT_READY at wake; READY / ERROR when the work ends&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;level&lt;/td&gt;&lt;td&gt;0 LOW, 1 MEDIUM, 2 HIGH, 3 FULL&lt;/td&gt;&lt;td&gt;after density computation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;meanGrad&lt;/td&gt;&lt;td&gt;0..255 raw Sobel mean&lt;/td&gt;&lt;td&gt;after density computation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;errCode&lt;/td&gt;&lt;td&gt;0 none, 1 cam init, 2 capture, 3 JPEG decode, 4 no PSRAM, 5 alloc&lt;/td&gt;&lt;td&gt;on failure&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;captureId&lt;/td&gt;&lt;td&gt;+1 per wake, wraps at 255 (kept in RTC memory)&lt;/td&gt;&lt;td&gt;at wake&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;crc&lt;/td&gt;&lt;td&gt;CRC-8 (0x07) over bytes 0..4&lt;/td&gt;&lt;td&gt;recomputed on every change&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="250" width="800" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="cw" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Command register: ATmega writes 1 byte&lt;/b&gt;&lt;br&gt;0x01 ESP_CMD_SLEEP : result read, go to deep sleep&lt;br&gt;0x02 ESP_CMD_ABORT : cancel, go to deep sleep&lt;br&gt;&lt;br&gt;&lt;b&gt;ATmega accepts a result only if&lt;/b&gt;&lt;br&gt;CRC ok, status = READY, captureId differs from the last cycle&lt;br&gt;&lt;br&gt;&lt;b&gt;&#39;Not ready&#39; means&lt;/b&gt;&lt;br&gt;address NACK, short read, bad CRC, or status NOT_READY" vertex="1">
          <mxGeometry height="250" width="400" x="880" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Reset / power-on" vertex="1">
          <mxGeometry height="50" width="150" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="DEEP SLEEP&lt;br&gt;ext0 wake: GPIO13 LOW" vertex="1">
          <mxGeometry height="60" width="180" x="240" y="335" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Wake: wait for line HIGH, start I2C slave 0x08, captureId++, status = NOT_READY" vertex="1">
          <mxGeometry height="80" width="220" x="470" y="325" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Camera init, discard 2 warm-up frames, capture QQVGA JPEG" vertex="1">
          <mxGeometry height="80" width="220" x="740" y="325" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Camera / decode ok?" vertex="1">
          <mxGeometry height="90" width="200" x="1010" y="320" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="JPEGDEC 96x96, grey, blur, Sobel mean; thresholds 30 / 55 / 75 give level 0..3. Fill level, meanGrad, status = READY" vertex="1">
          <mxGeometry height="90" width="260" x="740" y="470" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Fill errCode, status = ERROR" vertex="1">
          <mxGeometry height="90" width="200" x="1050" y="470" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Recompute CRC, then pulse wake line LOW for 30 ms (&#39;done&#39;)" vertex="1">
          <mxGeometry height="70" width="230" x="470" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Wait for ESP_CMD_SLEEP / ABORT or 20 s self-timeout" vertex="1">
          <mxGeometry height="70" width="190" x="240" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Release line, wait for HIGH, go to deep sleep" vertex="1">
          <mxGeometry height="70" width="150" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="g1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n3" value="wake pulse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g5" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" target="n6" value="Yes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="440" />
              <mxPoint x="1020" y="440" />
              <mxPoint x="1020" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="g5b" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="n7" value="No">
          <mxGeometry relative="1" x="-0.7448" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="365" />
              <mxPoint x="1300" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="g6" edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" target="n8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="600" />
              <mxPoint x="720" y="600" />
              <mxPoint x="720" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="g6b" edge="1" parent="1" source="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="n8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="620" />
              <mxPoint x="585" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="g7" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g8" edge="1" parent="1" source="n9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g9" edge="1" parent="1" source="n10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="n2" value="sleeping">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="115" y="430" />
              <mxPoint x="330" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cf" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;ESP32 config constants (esp_config.h)&lt;/b&gt;&lt;br&gt;I2C_SLAVE_ADDRESS 0x08 ; SDA GPIO15, SCL GPIO14&lt;br&gt;WAKE_GPIO 13 (RTC-capable, ext0 wake on LOW)&lt;br&gt;DONE_PULSE_MS 30 ; ESP_AWAKE_TIMEOUT_S 20&lt;br&gt;CAM_FRAME_SIZE QQVGA JPEG ; CAM_WARMUP_FRAMES 2 ; IMG 96 x 96&lt;br&gt;THRESH_LOW / MED / HIGH = 30 / 55 / 75 (retune on site)&lt;br&gt;USE_STORED_IMAGE 0 (bench test without a camera view)" vertex="1">
          <mxGeometry height="140" width="560" x="40" y="660" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
