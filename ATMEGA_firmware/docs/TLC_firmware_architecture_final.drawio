        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="FALLBACK&lt;br&gt;send nothing, abort ESP32" vertex="1">
