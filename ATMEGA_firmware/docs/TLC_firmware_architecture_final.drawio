  <diagram id="p4" name="8 Flow: ETLC protocol send and receive">
    <mxGraphModel dx="3003" dy="1693" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" parent="1" style="text;html=1;fontStyle=1;fontSize=16;" value="ATmega firmware flow 4/4: how the ATmega - ETLC protocol (TLCP) works. Left: send procedure. Right: receive procedure." vertex="1">
          <mxGeometry height="24" width="1200" x="40" as="geometry" />
        </mxCell>
        <mxCell id="t0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="send(cmd, payload)" vertex="1">
          <mxGeometry height="40" width="200" x="200" y="40" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Build frame: 0xA5, SEQ = txSeq++, CMD, LEN, PAYLOAD (big endian), CRC-8 over SEQ..PAYLOAD&lt;br&gt;attempt = 0" vertex="1">
          <mxGeometry height="80" width="280" x="160" y="110" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Bus idle for 5 ms?&lt;br&gt;(nothing being received)" vertex="1">
          <mxGeometry height="100" width="280" x="160" y="220" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Transmit: DE = 1, /RE = 1 (receiver off)&lt;br&gt;write all bytes, wait for TXC flag&lt;br&gt;DE = 0, /RE = 0 (back to receive)" vertex="1">
          <mxGeometry height="90" width="280" x="160" y="350" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Wait up to 150 ms for ACK or NAK with the same SEQ" vertex="1">
          <mxGeometry height="60" width="280" x="160" y="470" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Reply received?" vertex="1">
          <mxGeometry height="90" width="280" x="160" y="560" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="ACK or NAK?" vertex="1">
          <mxGeometry height="90" width="280" x="160" y="690" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="RETURN OK" vertex="1">
          <mxGeometry height="50" width="160" x="70" y="840" as="geometry" />
        </mxCell>
        <mxCell id="t8" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="RETURN NAK(reason)" vertex="1">
          <mxGeometry height="50" width="180" x="360" y="850" as="geometry" />
        </mxCell>
        <mxCell id="t9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="attempt++ ;  attempt &gt; 3 ?" vertex="1">
          <mxGeometry height="90" width="240" x="520" y="560" as="geometry" />
        </mxCell>
        <mxCell id="t10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="RETURN FAIL (no ACK)&lt;br&gt;caller applies its fault rule" vertex="1">
          <mxGeometry height="70" width="200" x="540" y="700" as="geometry" />
        </mxCell>
        <mxCell id="t11" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" value="Wait idle gap (5 ms), feed watchdog, retry with the SAME frame and SEQ" vertex="1">
          <mxGeometry height="70" width="240" x="520" y="440" as="geometry" />
        </mxCell>
        <mxCell id="u1" edge="1" parent="1" source="t0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u2" edge="1" parent="1" source="t1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u3" edge="1" parent="1" source="t2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t3" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u3b" edge="1" parent="1" source="t2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0;exitY=0.5;" value="No: wait">
          <mxGeometry relative="1" x="-0.4815" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="130" y="270" />
              <mxPoint x="130" y="200" />
            </Array>
            <mxPoint x="300" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="u4" edge="1" parent="1" source="t3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u5" edge="1" parent="1" source="t4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u6" edge="1" parent="1" source="t5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t6" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u7" edge="1" parent="1" source="t5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t9" value="No (timeout)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u8" edge="1" parent="1" source="t6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" target="t7" value="ACK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u9" edge="1" parent="1" source="t6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" target="t8" value="NAK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u10" edge="1" parent="1" source="t9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="t10" value="Yes (4 tries used)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u11" edge="1" parent="1" source="t9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="t11" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u12" edge="1" parent="1" source="t11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" target="t2" value="resend">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="receive (runs continuously while awake;&lt;br&gt;RX ISR fills a ring buffer)" vertex="1">
          <mxGeometry height="60" width="260" x="940" y="30" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Next byte == 0xA5 (SOF)?" vertex="1">
          <mxGeometry height="90" width="260" x="940" y="120" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Read SEQ, CMD, LEN (each within 20 ms)" vertex="1">
          <mxGeometry height="60" width="260" x="940" y="240" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="LEN &lt;= 4 and no timeout?" vertex="1">
          <mxGeometry height="90" width="260" x="940" y="330" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Read LEN payload bytes + CRC byte" vertex="1">
          <mxGeometry height="60" width="260" x="940" y="450" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="CRC-8 matches?" vertex="1">
          <mxGeometry height="90" width="260" x="940" y="540" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="CMD is ACK or NAK?" vertex="1">
          <mxGeometry height="90" width="260" x="940" y="660" as="geometry" />
        </mxCell>
        <mxCell id="r7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Hand to the waiting send() procedure (matched by SEQ)" vertex="1">
          <mxGeometry height="70" width="240" x="1300" y="670" as="geometry" />
        </mxCell>
        <mxCell id="r8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Same SEQ + CMD as the last accepted command?" vertex="1">
          <mxGeometry height="100" width="260" x="940" y="780" as="geometry" />
        </mxCell>
        <mxCell id="r9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Duplicate (our ACK was lost): wait 3 ms, resend the previous ACK, do NOT run the command again" vertex="1">
          <mxGeometry height="80" width="260" x="1300" y="790" as="geometry" />
        </mxCell>
        <mxCell id="r10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="New command: wait 3 ms. RED_STARTED / PING: reply ACK(OK). Unknown CMD: NAK(UNKNOWN_CMD). Bad LEN: NAK(BAD_LEN).&lt;br&gt;Remember SEQ + CMD, queue the command for the FSM." vertex="1">
          <mxGeometry height="100" width="340" x="900" y="920" as="geometry" />
        </mxCell>
        <mxCell id="r11" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="Drop byte / frame silently and go back to waiting for SOF. The sender&#39;s 150 ms timeout makes it retry." vertex="1">
          <mxGeometry height="90" width="260" x="1300" y="330" as="geometry" />
        </mxCell>
