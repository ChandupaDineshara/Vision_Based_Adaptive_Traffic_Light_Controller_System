          </mxGeometry>
        </mxCell>
        <mxCell id="m3" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;" value="RED_STARTED (secsToGreen)">
          <mxGeometry relative="1" as="geometry">
