        <mxCell id="p15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="COMPUTE: green = table[level]&lt;br&gt;clamp to [GREEN_MIN_S, GREEN_MAX_S]" vertex="1">
