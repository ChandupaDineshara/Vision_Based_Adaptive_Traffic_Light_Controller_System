        <mxCell id="p16" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="now + T_tx_worst &lt; t0 + R - G ?&lt;br&gt;(still early enough?)" vertex="1">
