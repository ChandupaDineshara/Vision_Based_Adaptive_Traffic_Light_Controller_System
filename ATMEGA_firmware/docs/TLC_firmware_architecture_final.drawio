        <mxCell id="s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="IDLE_SLEEP&lt;br&gt;power-down, RTC alarm armed" vertex="1">
