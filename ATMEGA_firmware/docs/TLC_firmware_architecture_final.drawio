  <diagram id="p1" name="5 Flow: boot, sleep, alarm">
    <mxGraphModel dx="1201" dy="677" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" parent="1" style="text;html=1;fontStyle=1;fontSize=16;" value="ATmega firmware flow 1/4: boot, sleep and alarm wake" vertex="1">
          <mxGeometry height="24" width="700" x="40" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="START (power-up / reset)" vertex="1">
          <mxGeometry height="40" width="200" x="300" y="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Init: GPIO released&amp;nbsp;&lt;div&gt;(wake line = input, DE/RE = receive),&amp;nbsp;&lt;/div&gt;&lt;div&gt;UART 9600,&amp;nbsp;&lt;/div&gt;&lt;div&gt;I2C 100 kHz,&amp;nbsp;&lt;/div&gt;&lt;div&gt;load EEPROM params (bad CRC = defaults)&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="260" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="DS3231 OSF flag set?&lt;br&gt;(or RTC not answering)" vertex="1">
          <mxGeometry height="100" width="280" x="260" y="210" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="rtcValid = false&lt;br&gt;FAULT_RTC_OSF / RTC_COMM&lt;br&gt;No peak operation, ETLC stays on fixed timing" vertex="1">
          <mxGeometry height="80" width="260" x="640" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n4b" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Idle until time is set (debug build command) and chip is reset" vertex="1">
          <mxGeometry height="90" width="220" x="960" y="215" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Current RTC time inside a&lt;br&gt;schedule window today?" vertex="1">
          <mxGeometry height="100" width="280" x="260" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n5y" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="First arm the NEXT alarm (as in the box on the left), then GO TO PAGE 2: peak window" vertex="1">
          <mxGeometry height="90" width="280" x="640" y="355" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Compute next window start (earliest enabled entry, today or later)&lt;br&gt;Write Alarm 1, set A1IE, clear A1F" vertex="1">
          <mxGeometry height="80" width="280" x="260" y="490" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Enable Enable the RTC alarm interrupt (A3), enter power-down sleep&lt;br&gt;(ESP32 already in deep sleep, ETLC link not listened)" vertex="1">
          <mxGeometry height="80" width="280" x="260" y="610" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="RTC alarm pulls INT/SQW LOW: CPU wakes&lt;br&gt;ISR: mask the alarm interrupt, set alarmFlag (nothing else)" vertex="1">
          <mxGeometry height="70" width="280" x="260" y="730" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Main loop: clear A1F over I2C, read time,&lt;br&gt;compute and arm the NEXT alarm (before anything else)" vertex="1">
          <mxGeometry height="80" width="280" x="260" y="840" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Day-of-week bit set in dowMask&lt;br&gt;AND time inside the window?" vertex="1">
          <mxGeometry height="100" width="280" x="260" y="960" as="geometry" />
        </mxCell>
        <mxCell id="n10y" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="GO TO PAGE 2: peak window" vertex="1">
          <mxGeometry height="70" width="260" x="640" y="975" as="geometry" />
        </mxCell>
        <mxCell id="a1" edge="1" parent="1" source="n1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" parent="1" source="n2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n4" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3b" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n5" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n5y" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n6" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" edge="1" parent="1" source="n7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n8" value="alarm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a10" edge="1" parent="1" source="n9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a11" edge="1" parent="1" source="n10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="n10y" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a12" edge="1" parent="1" source="n10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="n7" value="No (wrong day): back to sleep">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="1010" />
              <mxPoint x="200" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="nt" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" value="From page 2 (peak over): the next alarm is already armed, return here to the sleep block" vertex="1">
          <mxGeometry height="70" width="260" x="640" y="610" as="geometry" />
        </mxCell>
        <mxCell id="n2pk" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Two peak windows per day&lt;/b&gt;&lt;br&gt;The alarm is ALWAYS re-armed to the next start (any entry, today or later) the moment the interrupt is handled, before the peak sequence begins.&lt;br&gt;Morning start fires: arm evening start.&lt;br&gt;Evening start fires: arm next scheduled day morning start.&lt;br&gt;Boot inside a window: arm next start first, then run the peak." vertex="1">
          <mxGeometry height="130" width="300" x="640" y="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="6 Flow: peak window loop">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" parent="1" style="text;html=1;fontStyle=1;fontSize=16;" value="ATmega firmware flow 2/4: peak window (ATmega stays awake until the window ends; watchdog fed in every wait)" vertex="1">
          <mxGeometry height="24" width="1000" x="40" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="PEAK_NOTIFY: send PEAK_START&lt;br&gt;(send procedure, page 4)" vertex="1">
          <mxGeometry height="60" width="200" x="200" y="30" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="ACK received?" vertex="1">
          <mxGeometry height="90" width="200" x="200" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="PEAK_FALLBACK (FAULT_ETLC_NO_ACK)&lt;br&gt;send PING every 60 s until ACKed" vertex="1">
          <mxGeometry height="80" width="240" x="520" y="125" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="WAIT_FOR_RED: feed watchdog, read RTC" vertex="1">
          <mxGeometry height="60" width="200" x="200" y="240" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="RTC time &gt;= window end?" vertex="1">
          <mxGeometry height="90" width="200" x="200" y="330" as="geometry" />
        </mxCell>
        <mxCell id="pend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="PEAK_ENDING: if a cycle is running send ESP_CMD_ABORT.&lt;br&gt;Send PEAK_END (send procedure, 3 retries; no ACK = log FAULT_PEAKEND_NO_ACK and continue)" vertex="1">
          <mxGeometry height="100" width="300" x="520" y="320" as="geometry" />
        </mxCell>
        <mxCell id="pend2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="GO TO PAGE 1: next alarm already armed, enter sleep block" vertex="1">
          <mxGeometry height="60" width="260" x="540" y="440" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Valid RED_STARTED frame received?&lt;br&gt;(link layer ACKs PING and duplicates itself)" vertex="1">
          <mxGeometry height="110" width="260" x="170" y="450" as="geometry" />
        </mxCell>
        <mxCell id="p8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Send ACK for RED_STARTED at once.&lt;br&gt;R = secsToGreen, t0 = now" vertex="1">
          <mxGeometry height="70" width="240" x="1000" y="30" as="geometry" />
        </mxCell>
        <mxCell id="p10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="A_eff = min(A, R - T_esp - T_tx - G)" vertex="1">
          <mxGeometry height="60" width="240" x="1000" y="130" as="geometry" />
        </mxCell>
