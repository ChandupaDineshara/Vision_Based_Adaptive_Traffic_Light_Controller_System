        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="CAPTURE&lt;br&gt;wake pulse + wait for done, read once" vertex="1">
          <mxGeometry height="60" width="150" x="1110" y="550" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="COMPUTE&lt;br&gt;level -&gt; green, clamp, deadline" vertex="1">
