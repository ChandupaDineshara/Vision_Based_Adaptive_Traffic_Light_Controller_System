        </mxCell>
        <mxCell id="m5" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#b85450;" value="wake pulse: 100 ms LOW">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="300" as="sourcePoint" />
            <mxPoint x="750" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="boot, capture, density" vertex="1">
          <mxGeometry height="30" width="110" x="770" y="315" as="geometry" />
        </mxCell>
        <mxCell id="m6" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;" value="(ATmega waits; no I2C traffic during capture)">
          <mxGeometry relative="1" as="geometry">
