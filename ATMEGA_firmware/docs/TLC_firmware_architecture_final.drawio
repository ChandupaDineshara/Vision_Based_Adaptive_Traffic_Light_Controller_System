        <mxCell id="oE" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;" value="ETLC" vertex="1">
          <mxGeometry height="700" width="100" x="100" y="720" as="geometry" />
