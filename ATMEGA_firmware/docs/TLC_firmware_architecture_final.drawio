        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="ACCUMULATE&lt;br&gt;wait A_eff s" vertex="1">
