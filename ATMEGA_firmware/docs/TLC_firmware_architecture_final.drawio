  <diagram id="p3" name="7 Flow: capture sub-flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" parent="1" style="text;html=1;fontStyle=1;fontSize=16;" value="ATmega firmware flow 3/4: CAPTURE sub-flow. ATmega stays awake and busy-waits for the ESP32 done pulse, then reads the result once." vertex="1">
          <mxGeometry height="24" width="1100" x="40" as="geometry" />
        </mxCell>
        <mxCell id="s0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="CAPTURE start" vertex="1">
          <mxGeometry height="40" width="200" x="400" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Wake line already LOW?" vertex="1">
          <mxGeometry height="90" width="280" x="360" y="100" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Wake pulse: PORT bit = 0, then DDR = output (line LOW) for 100 ms, then DDR = input (release). Pin-change on this pin not used." vertex="1">
          <mxGeometry height="90" width="280" x="360" y="220" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Line back HIGH within 500 ms?" vertex="1">
          <mxGeometry height="90" width="280" x="360" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Start ESP_TIMEOUT timer (15 s). ATmega stays awake, feeds watchdog." vertex="1">
          <mxGeometry height="70" width="280" x="360" y="460" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Falling edge on wake line?&lt;br&gt;(ESP32 &quot;done&quot; pulse)" vertex="1">
          <mxGeometry height="90" width="280" x="360" y="610" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="15 s timeout elapsed?" vertex="1">
          <mxGeometry height="90" width="240" x="720" y="610" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Measure the LOW width; wait until the line is HIGH again" vertex="1">
          <mxGeometry height="70" width="280" x="360" y="740" as="geometry" />
        </mxCell>
        <mxCell id="s7d" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="LOW width 10-80 ms?" vertex="1">
          <mxGeometry height="90" width="280" x="360" y="840" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="I2C requestFrom(0x08, 6): ONE read" vertex="1">
          <mxGeometry height="60" width="280" x="360" y="960" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="6 bytes received, CRC-8 ok, and status?" vertex="1">
          <mxGeometry height="100" width="280" x="360" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="captureId differs from the one stored last cycle?" vertex="1">
          <mxGeometry height="100" width="280" x="360" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="s11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Store level, meanGrad, captureId. Write ESP_CMD_SLEEP to the ESP32." vertex="1">
          <mxGeometry height="70" width="280" x="360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="s12" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="RETURN OK (level, meanGrad)" vertex="1">
          <mxGeometry height="50" width="220" x="390" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="fb1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="One last I2C read (the done pulse may have been missed)" vertex="1">
          <mxGeometry height="70" width="240" x="720" y="750" as="geometry" />
        </mxCell>
        <mxCell id="fb2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Valid READY frame and new captureId?" vertex="1">
          <mxGeometry height="100" width="240" x="1085" y="735" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="RETURN FAIL: FAULT_WAKE_LINE_STUCK" vertex="1">
          <mxGeometry height="70" width="250" x="800" y="110" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Send ESP_CMD_ABORT (ignore result). RETURN FAIL: FAULT_ESP_TIMEOUT" vertex="1">
          <mxGeometry height="90" width="250" x="1080" y="590" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="RETURN FAIL: FAULT_ESP_ERROR (errCode logged)" vertex="1">
          <mxGeometry height="80" width="250" x="835" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="RETURN FAIL: FAULT_ESP_BAD_DATA (stale captureId)" vertex="1">
          <mxGeometry height="80" width="250" x="835" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="nt" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Why one read after the pulse&lt;/b&gt;&lt;br&gt;The ESP32 raises done only when the result is final. No I2C traffic while it boots and runs the camera. The pulse is the trigger; the single fallback read after the timeout covers a missed pulse." vertex="1">
          <mxGeometry height="130" width="300" x="1020" y="230" as="geometry" />
        </mxCell>
