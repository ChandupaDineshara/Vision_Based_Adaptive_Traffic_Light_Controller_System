        </mxCell>
        <mxCell id="s9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="PEAK_ENDING&lt;br&gt;send PEAK_END, re-arm alarm" vertex="1">
          <mxGeometry height="60" width="150" x="90" y="290" as="geometry" />
        </mxCell>
        <mxCell id="t0" edge="1" parent="1" source="s0" style="endArrow=classic;html=1;" target="s1" value="RTC alarm + window active">
