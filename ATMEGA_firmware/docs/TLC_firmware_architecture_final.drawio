        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="PEAK_FALLBACK&lt;br&gt;PING until ETLC answers" vertex="1">
